{
  "format_version": "1.26.50",
  "minecraft:entity": {
    "description": {
      "identifier": "lothlorien:songbird",
      "spawn_category": "creature",
      "is_spawnable": true,
      "is_summonable": true,
      "properties": {
        "lothlorien:plumage": {
          "type": "enum",
          "values": [
            "blue",
            "yellow",
            "pink"
          ],
          "default": "blue",
          "client_sync": true
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "lothlorien_songbird",
          "mob"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.4,
        "height": 0.5
      },
      "minecraft:health": {
        "value": 4,
        "max": 4
      },
      "minecraft:movement": {
        "value": 0.3
      },
      "minecraft:movement.fly": {},
      "minecraft:can_fly": {},
      "minecraft:navigation.fly": {
        "can_path_from_air": true,
        "can_path_over_water": true
      },
      "minecraft:jump.static": {},
      "minecraft:physics": {},
      "minecraft:nameable": {},
      "minecraft:leashable": {},
      "minecraft:balloonable": {},
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:game_event_movement_tracking": {
        "emit_flap": true
      },
      "minecraft:damage_sensor": {
        "triggers": {
          "cause": "fall",
          "deals_damage": "no"
        }
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self"
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? Math.Random(1,2) : 0"
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/songbird.json"
      },
      "minecraft:ambient_sound_interval": {
        "event_name": "ambient",
        "value": 6,
        "range": 14
      },
      "minecraft:behavior.float": {
        "priority": 1
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 1.25
      },
      "minecraft:behavior.random_fly": {
        "priority": 3,
        "xz_dist": 12,
        "y_dist": 1,
        "speed_multiplier": 1.0,
        "can_land_on_trees": true
      },
      "minecraft:behavior.follow_mob": {
        "priority": 4,
        "search_range": 12,
        "speed_multiplier": 1.0,
        "stop_distance": 3
      },
      "minecraft:behavior.look_at_player": {
        "priority": 5,
        "look_distance": 6,
        "probability": 0.02,
        "look_time": {
          "min": 1,
          "max": 2
        }
      },
      "minecraft:behavior.random_look_around": {
        "priority": 6
      },
      "minecraft:pushable_by_entity": {},
      "minecraft:pushable_by_block": {}
    },
    "events": {
      "minecraft:entity_spawned": {
        "randomize": [
          {
            "weight": 40,
            "set_property": {
              "lothlorien:plumage": "blue"
            }
          },
          {
            "weight": 30,
            "set_property": {
              "lothlorien:plumage": "yellow"
            }
          },
          {
            "weight": 30,
            "set_property": {
              "lothlorien:plumage": "pink"
            }
          }
        ]
      }
    }
  }
}
