{
  "format_version": "1.13.0",
  "minecraft:tree_feature": {
    "description": {
      "identifier": "lothlorien:mallorn_simple_tree_feature"
    },
    "trunk": {
      "trunk_height": {
        "range_min": 6,
        "range_max": 10
      },
      "trunk_block": {
        "name": "lothlorien:mallorn_log"
      }
    },
    "canopy": {
      "canopy_offset": {
        "min": -3,
        "max": 0
      },
      "variation_chance": [
        {
          "numerator": 1,
          "denominator": 2
        },
        {
          "numerator": 1,
          "denominator": 2
        },
        {
          "numerator": 1,
          "denominator": 2
        },
        {
          "numerator": 1,
          "denominator": 1
        }
      ],
      "leaf_block": {
        "name": "lothlorien:mallorn_leaves"
      }
    },
    "may_grow_on": [
      {
        "tags": "query.any_tag('dirt')"
      }
    ],
    "base_block": [
      "minecraft:dirt",
      "minecraft:coarse_dirt"
    ],
    "may_grow_through": [
      {
        "tags": "query.any_tag('dirt')"
      }
    ],
    "may_replace": [
      "minecraft:air",
      "minecraft:snow_layer",
      {
        "tags": "query.any_tag('leaves')"
      },
      "minecraft:wildflowers",
      "minecraft:leaf_litter"
    ]
  }
}
