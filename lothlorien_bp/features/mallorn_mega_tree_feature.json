{
  "format_version": "1.13.0",
  "minecraft:tree_feature": {
    "description": {
      "identifier": "lothlorien:mallorn_mega_tree_feature"
    },
    "mega_trunk": {
      "trunk_width": 2,
      "trunk_height": {
        "base": 14,
        "intervals": [
          3,
          12
        ]
      },
      "trunk_block": {
        "name": "lothlorien:mallorn_log"
      },
      "branches": {
        "branch_length": 6,
        "branch_slope": 0.5,
        "branch_interval": {
          "range_min": 2,
          "range_max": 5
        },
        "branch_altitude_factor": {
          "min": 0.5,
          "max": 1.0
        },
        "branch_canopy": {
          "mega_canopy": {
            "canopy_height": {
              "range_min": 2,
              "range_max": 4
            },
            "base_radius": 2,
            "simplify_canopy": true,
            "leaf_block": {
              "name": "lothlorien:mallorn_leaves"
            }
          }
        }
      }
    },
    "mega_canopy": {
      "canopy_height": 4,
      "base_radius": 3,
      "core_width": 2,
      "leaf_block": {
        "name": "lothlorien:mallorn_leaves"
      }
    },
    "may_grow_on": [
      {
        "tags": "query.any_tag('dirt')"
      }
    ],
    "base_block": [
      "minecraft:dirt",
      "minecraft:coarse_dirt"
    ],
    "may_grow_through": [
      {
        "tags": "query.any_tag('dirt')"
      }
    ],
    "may_replace": [
      "minecraft:air",
      "minecraft:snow_layer",
      {
        "tags": "query.any_tag('leaves')"
      },
      "minecraft:wildflowers",
      "minecraft:leaf_litter"
    ]
  }
}
