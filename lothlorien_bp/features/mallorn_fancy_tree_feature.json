{
  "format_version": "1.13.0",
  "minecraft:tree_feature": {
    "description": {
      "identifier": "lothlorien:mallorn_fancy_tree_feature"
    },
    "fancy_trunk": {
      "trunk_height": {
        "base": 7,
        "variance": 9,
        "scale": 0.618
      },
      "trunk_width": 1,
      "trunk_block": {
        "name": "lothlorien:mallorn_log"
      },
      "branches": {
        "slope": 0.381,
        "density": 1.0,
        "min_altitude_factor": 0.2
      },
      "width_scale": 1.0,
      "foliage_altitude_factor": 0.3
    },
    "fancy_canopy": {
      "height": 4,
      "radius": 3,
      "leaf_block": {
        "name": "lothlorien:mallorn_leaves"
      }
    },
    "may_grow_on": [
      {
        "tags": "query.any_tag('dirt')"
      }
    ],
    "base_block": [
      "minecraft:dirt",
      "minecraft:coarse_dirt"
    ],
    "may_grow_through": [
      {
        "tags": "query.any_tag('dirt')"
      }
    ],
    "may_replace": [
      "minecraft:air",
      "minecraft:snow_layer",
      {
        "tags": "query.any_tag('leaves')"
      },
      "minecraft:wildflowers",
      "minecraft:leaf_litter"
    ]
  }
}
