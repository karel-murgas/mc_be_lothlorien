{
  "format_version": "1.13.0",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "lothlorien:mallorn_giant_feature_rules",
      "places_feature": "lothlorien:mallorn_giant_feature"
    },
    "conditions": {
      "placement_pass": "before_surface_pass",
      "minecraft:biome_filter": [
        {
          "test": "has_biome_tag",
          "value": "lothlorien"
        }
      ]
    },
    "distribution": {
      "iterations": "(math.mod(variable.originx / 16, 3) == 0 && math.mod(variable.originz / 16, 3) == 0) ? 1 : 0",
      "scatter_chance": {
        "numerator": 1,
        "denominator": 3
      },
      "x": {
        "distribution": "uniform",
        "extent": [
          2,
          10
        ]
      },
      "y": "query.heightmap(variable.worldx, variable.worldz)",
      "z": {
        "distribution": "uniform",
        "extent": [
          2,
          10
        ]
      }
    }
  }
}
