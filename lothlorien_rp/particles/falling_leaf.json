{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "lothlorien:falling_leaf",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/mallorn_leaf"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": 1 },
      "minecraft:emitter_lifetime_once": { "active_time": 1 },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": { "max_lifetime": "9 + math.random(0, 5)" },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-60, 60)"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(variable.particle_age * 200) * 0.8",
          -1.0,
          "math.cos(variable.particle_age * 160) * 0.8"
        ],
        "linear_drag_coefficient": 2.0
      },
      "minecraft:particle_motion_collision": {
        "enabled": true,
        "collision_drag": 4.0,
        "coefficient_of_restitution": 0.0,
        "collision_radius": 0.05,
        "expire_on_contact": true
      },
      "minecraft:particle_appearance_billboard": {
        "size": [ "0.10 + variable.particle_random_3 * 0.04", "0.10 + variable.particle_random_3 * 0.04" ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 40,
          "texture_height": 8,
          "uv": [ "(variable.particle_random_1 < 0.14 ? 4 : math.floor(variable.particle_random_2 * 4)) * 8", 0 ],
          "uv_size": [ 8, 8 ]
        }
      }
    }
  }
}
