{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "lothlorien:test_critter",
      "min_engine_version": "1.8.0",
      "materials": { "default": "rabbit" },
      "textures": { "default": "textures/entity/rabbit/gold" },
      "geometry": { "default": "geometry.rabbit.v1.8" },
      "animations": {
        "move": "animation.rabbit.move",
        "look_at_target": "animation.common.look_at_target"
      },
      "scripts": {
        "pre_animation": [ "variable.jump_rotation = 0;" ],
        "animate": [ "move", { "look_at_target": "query.is_alive" } ]
      },
      "render_controllers": [ "controller.render.default" ],
      "spawn_egg": { "base_color": "#e0b43a", "overlay_color": "#6b4a12" }
    }
  }
}
