{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "lothlorien:white_deer",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/deer/deer_white"
      },
      "geometry": {
        "default": "geometry.lothlorien.deer",
        "buck": "geometry.lothlorien.deer_buck"
      },
      "animations": {
        "idle": "animation.lothlorien.deer.idle",
        "walk": "animation.lothlorien.deer.walk",
        "run": "animation.lothlorien.deer.run",
        "look_at_target": "animation.lothlorien.deer.look_at_target"
      },
      "scripts": {
        "animate": [
          "idle",
          {
            "walk": "query.modified_move_speed * (1.0 - math.clamp((query.ground_speed - 3.5) / 2.5, 0.0, 1.0))"
          },
          {
            "run": "math.clamp((query.ground_speed - 3.5) / 2.5, 0.0, 1.0)"
          },
          "look_at_target"
        ]
      },
      "render_controllers": [
        "controller.render.lothlorien.white_deer"
      ],
      "spawn_egg": {
        "base_color": "#e3e7ee",
        "overlay_color": "#a6adbb"
      }
    }
  }
}
