{
  "format_version": "1.8.0",
  "animations": {
    "animation.lothlorien.songbird.idle": {
      "loop": true,
      "bones": {
        "tail": {
          "rotation": [
            "math.sin(query.life_time * 180.0) * 3.0",
            0,
            0
          ]
        },
        "head": {
          "rotation": [
            0,
            0,
            "math.sin(query.life_time * 90.0) * 4.0"
          ]
        }
      }
    },
    "animation.lothlorien.songbird.hop": {
      "loop": true,
      "anim_time_update": "query.modified_distance_moved",
      "bones": {
        "body": {
          "position": [
            0,
            "math.abs(math.sin(query.anim_time * 400.0)) * 0.8",
            0
          ]
        },
        "leg_l": {
          "rotation": [
            "math.sin(query.anim_time * 400.0) * 35.0",
            0,
            0
          ]
        },
        "leg_r": {
          "rotation": [
            "math.sin(query.anim_time * 400.0) * 35.0",
            0,
            0
          ]
        },
        "head": {
          "rotation": [
            "math.sin(query.anim_time * 800.0) * 4.0",
            0,
            0
          ]
        }
      }
    },
    "animation.lothlorien.songbird.fly": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [
            -10,
            0,
            0
          ]
        },
        "wing_l": {
          "rotation": [
            0,
            0,
            "-55.0 + math.sin(query.life_time * 2000.0) * 35.0"
          ]
        },
        "wing_r": {
          "rotation": [
            0,
            0,
            "55.0 - math.sin(query.life_time * 2000.0) * 35.0"
          ]
        },
        "leg_l": {
          "rotation": [
            50,
            0,
            0
          ]
        },
        "leg_r": {
          "rotation": [
            50,
            0,
            0
          ]
        },
        "tail": {
          "rotation": [
            "math.sin(query.life_time * 2000.0) * 5.0",
            0,
            0
          ]
        }
      }
    }
  }
}
