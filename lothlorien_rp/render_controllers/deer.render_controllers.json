{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.lothlorien.deer": {
      "geometry": "query.is_baby ? Geometry.baby : (query.property('lothlorien:sex') == 'buck' ? Geometry.buck : Geometry.default)",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "query.is_baby ? (query.property('lothlorien:coat') == 'white' ? Texture.white_baby : Texture.baby) : (query.property('lothlorien:coat') == 'white' ? Texture.white : Texture.default)"
      ]
    }
  }
}
