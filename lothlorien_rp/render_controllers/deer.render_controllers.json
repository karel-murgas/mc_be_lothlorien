{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.lothlorien.deer": {
      "geometry": "query.is_baby ? Geometry.baby : Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "query.is_baby ? Texture.baby : Texture.default"
      ],
      "part_visibility": [
        {
          "antler_*": "query.property('lothlorien:sex') == 'buck' && !query.is_baby"
        }
      ]
    }
  }
}
