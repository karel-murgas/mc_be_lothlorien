{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.lothlorien.squirrel": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "query.property('lothlorien:coat') == 'russet' ? Texture.russet : (query.property('lothlorien:coat') == 'dark' ? Texture.dark : Texture.brown)"
      ]
    }
  }
}
