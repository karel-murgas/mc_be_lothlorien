{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.lothlorien.songbird": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "query.property('lothlorien:plumage') == 'yellow' ? Texture.yellow : (query.property('lothlorien:plumage') == 'pink' ? Texture.pink : Texture.blue)"
      ]
    }
  }
}
